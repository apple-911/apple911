  /**
   * 批量患者筛?
   * @param patientIds 患?ID 列表
   * @param filters 过滤条件
   */
  async batchScreening(options: {
    patientIds: string[]
    filters?: {
      department?: string
      admissionDateRange?: {
        start: string
        end: string
      }
      diagnosis?: string[]
      excludeMDT?: boolean // 排除已进?MDT 的患?
    }
  }): Promise<BatchScreeningResult> {
    const response = await aiApi.post('/screening/batch', options)
    return response.data as BatchScreeningResult
  }

  /**
   * 实时筛查（患者入院时自动触发
   * @param patientInfo 患者信?
   */
  async realtimeScreening(patientInfo: {
    patientId: string
    name: string
    age: number
    gender: string
    department: string
    chiefComplaint: string
    preliminaryDiagnosis: string
    pastHistory: string[]
  }): Promise<{
    screeningId: string
    score: number
    recommendation: MDTNecessityAssessment['recommendationLevel']
    alerts: ScreeningAlert[]
    suggestedActions: string[]
  }> {
    const response = await aiApi.post('/screening/realtime', {
      patientInfo,
      timestamp: new Date().toISOString()
    })
    return response.data
  }

  /**
   * 获取筛查规则
   * @param category 规则类别
   */
  async getScreeningRules(category?: 'absolute' | 'relative' | 'exclusion'): Promise<ScreeningRule[]> {
    const response = await aiApi.get('/screening/rules', {
      params: { category }
    })
    return response.data as ScreeningRule[]
  }

  /**
   * 更新筛查规则（管理员功能
   * @param ruleId 规则 ID
   * @param updates 更新内容
   */
  async updateScreeningRule(ruleId: string, updates: Partial<ScreeningRule>): Promise<ScreeningRule> {
    const response = await aiApi.put(`/screening/rules/${ruleId}`, updates)
    return response.data as ScreeningRule
  }

