  /**
   * 获取筛查统计
   * @param period 统计期间
   */
  async getStatistics(period: {
    start: string
    end: string
  }): Promise<{
    totalScreenings: number
    mdtNeededRate: number
    averageScore: number
    trend: number[]
    departmentComparison: Array<{
      department: string
      total: number
      mdtNeeded: number
      rate: number
    }>
    accuracyMetrics: {
      truePositive: number
      falsePositive: number
      trueNegative: number
      falseNegative: number
      accuracy: number
      sensitivity: number
      specificity: number
    }
  }> {
    const response = await aiApi.get('/screening/statistics', {
      params: period
    })
    return response.data
  }

  /**
   * 导出筛查报告
   * @param options 导出选项
   */
  async exportReport(options: {
    format: 'pdf' | 'excel' | 'csv'
    patientIds?: string[]
    dateRange?: {
      start: string
      end: string
    }
    includeDetails: boolean
  }): Promise<{
    reportId: string
    downloadUrl: string
    expiresAt: string
    fileSize: number
  }> {
    const response = await aiApi.post('/screening/export', options)
    return response.data
  }

  /**
   * 模型性能监控
   */
  async getModelPerformance(): Promise<{
    modelVersion: string
    lastUpdated: string
    metrics: {
      accuracy: number
      precision: number
      recall: number
      f1Score: number
      auc: number
    }
    confusionMatrix: {
      truePositive: number
      falsePositive: number
      trueNegative: number
      falseNegative: number
    }
    recentPredictions: number
    feedbackScore: number
  }> {
    const response = await aiApi.get('/screening/model-performance')
    return response.data
  }
}

export default new AIPatientScreeningService()
