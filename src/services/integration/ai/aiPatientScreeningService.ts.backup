/**
 * AI 患?MDT 需求筛查服?
 * 
 * 基于患者病情自动评估是否需?MDT 会诊，提供智能分级和预警
 * 避免医疗资源浪费，确保真正需要的患者得?MDT 服务
 */

import { aiApi } from '../../../utils/api'

// MDT 适应症评估结?
export interface MDTNecessityAssessment {
  // 患者基本信?
  patientInfo: {
    patientId: string
    name: string
    age: number
    gender: string
    department: string
    admissionDate: string
  }
  // MDT 必要性评?
  necessityScore: number
  // 推荐等级
  recommendationLevel: '强烈推荐' | '推荐' | '可考虑' | '不推荐'
  // 适应证匹配
  indications: {
    matched: MDTIndication[]
    notMatched: MDTIndication[]
  }
  // 评估维度
  assessmentDimensions: {
    diseaseComplexity: DiseaseComplexityAssessment
    treatmentDifficulty: TreatmentDifficultyAssessment
    prognosis: PrognosisAssessment
    socialFactors: SocialFactorsAssessment
  }
  // 推荐会诊类型
  recommendedType: '院内 MDT' | '远程 MDT' | '床旁 MDT' | '无需 MDT'
  // 推荐科室
  recommendedDepartments: string[]
  // 紧急程度
  urgency: '紧急' | '常规' | '择期'
  // 预期获益
  expectedBenefits: string[]
  // 不推荐理由（如适用
  notRecommendedReasons?: string[]
  // 置信
  confidence: number
}

// MDT 适应?
export interface MDTIndication {
  code: string
  name: string
  category: '疾病复杂' | '治疗困难' | '预后不良' | '社会因素'
  description: string
  weight: number
  matched: boolean
  evidence?: string
}

// 疾病复杂度评?
export interface DiseaseComplexityAssessment {
  score: number
  factors: Array<{
    factor: string
    present: boolean
    weight: number
    description: string
  }>
  diagnosis: {
    primary: string
    secondary: string[]
    icd10: string[]
    rarity: 'common' | 'uncommon' | 'rare' | 'very_rare'
    complexity: 'simple' | 'moderate' | 'complex' | 'very_complex'
  }
  stage: {
    tnm?: {
      t: string
      n: string
      m: string
      stage: string
    }
    stage: 'I' | 'II' | 'III' | 'IV'
    metastasis: boolean
  }
  comorbidities: {
    count: number
    list: Array<{
      name: string
      severity: 'mild' | 'moderate' | 'severe'
      impact: number
    }>
    cci: number // Charlson 合并症指
  }
}

// 治疗难度评估
export interface TreatmentDifficultyAssessment {
  score: number
  factors: Array<{
    factor: string
    present: boolean
    weight: number
    description: string
  }>
  previousTreatments: Array<{
    type: 'surgery' | 'chemotherapy' | 'radiotherapy' | 'targeted' | 'immunotherapy'
    regimen: string
    duration: string
    response: 'CR' | 'PR' | 'SD' | 'PD'
    toxicity: string
  }>
  currentChallenges: string[]
  availableOptions: number
  guidelineCompliance: 'compliant' | 'partially_compliant' | 'non_compliant'
}

// 预后评估
export interface PrognosisAssessment {
  score: number
  factors: Array<{
    factor: string
    present: boolean
    impact: 'positive' | 'negative' | 'neutral'
    weight: number
  }>
  survivalEstimate: {
    months6: number
    oneYear: number
    twoYear: number
    fiveYear: number
  }
  qualityOfLife: {
    current: number
    predicted: number
    trend: 'improving' | 'stable' | 'declining'
  }
  recurrenceRisk: 'low' | 'intermediate' | 'high'
}

// 社会因素评估
export interface SocialFactorsAssessment {
  score: number
  factors: Array<{
    factor: string
    present: boolean
    impact: number
    description: string
  }>
  economicStatus: 'low' | 'medium' | 'high'
  familySupport: 'poor' | 'moderate' | 'good' | 'excellent'
  insuranceType: 'self_pay' | 'basic' | 'commercial' | 'comprehensive'
  psychologicalState: 'good' | 'mild_anxiety' | 'moderate_anxiety' | 'severe_anxiety'
  healthLiteracy: 'low' | 'medium' | 'high'
}

// 筛查规则
export interface ScreeningRule {
  id: string
  name: string
  category: 'absolute' | 'relative' | 'exclusion'
  priority: number
  conditions: Array<{
    field: string
    operator: 'equals' | 'contains' | 'greater_than' | 'less_than' | 'in' | 'not_in'
    value: any
    weight: number
  }>
  action: {
    type: 'recommend' | 'exclude' | 'flag'
    level: 'strong' | 'moderate' | 'weak'
    message: string
  }
  evidence: {
    guideline: string
    level: 'I' | 'II' | 'III' | 'IV' | 'V'
  }
}

// 预警信息
export interface ScreeningAlert {
  id: string
  type: 'mdt_needed' | 'mdt_not_needed' | 'needs_review'
  level: 'info' | 'warning' | 'urgent'
  title: string
  message: string
  patientId: string
  patientName: string
  department: string
  score: number
  recommendation: string
  reasons: string[]
  suggestedActions: string[]
  timestamp: string
  reviewed: boolean
  reviewedBy?: string
  reviewedAt?: string
  reviewComment?: string
}

// 批量筛查结果
export interface BatchScreeningResult {
  totalPatients: number
  screenedPatients: number
  mdtNeeded: number
  mdtNotNeeded: number
  needsReview: number
  results: Array<{
    patientId: string
    patientName: string
    score: number
    recommendation: MDTNecessityAssessment['recommendationLevel']
    urgency: MDTNecessityAssessment['urgency']
    alerts: number
  }>
  statistics: {
    averageScore: number
    scoreDistribution: {
      high: number // 80-100
      medium: number // 60-79
      low: number // 40-59
      veryLow: number // 0-39
    }
    departmentBreakdown: Array<{
      department: string
      total: number
      mdtNeeded: number
      percentage: number
    }>
  }
  timestamp: string
}

